          </draw:frame>Figura <text:sequence text:ref-name="refFigure26" text:name="Figure" text:formula="ooow:Figure+1" style:num-format="1">27</text:sequence>: CONTABILTA</text:p>
        </draw:text-box>
       </draw:frame></text:p>
