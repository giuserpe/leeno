     </table:table-cell>
     <table:table-cell table:style-name="Tabella65.B1" office:value-type="string">
      <text:p text:style-name="P300">I codici ripetuti in <text:span text:style-name="T165">Elenco Prezzi</text:span> non possono coesistere, perché il codice di prezzo costituisce l’equivalente della chiave primaria di un database che deve necessariamente essere univoca.</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P301"><text:span text:style-name="T655">L</text:span><text:span text:style-name="T208">&apos;esecuzione </text:span><text:span text:style-name="T656">di</text:span><text:span text:style-name="T208"> </text:span><text:span text:style-name="Ultimus_5f_Testo"><text:span text:style-name="T347">LeenO&gt;</text:span></text:span><text:span text:style-name="Ultimus_5f_Testo"><text:span text:style-name="T657">Elimina Codici</text:span></text:span><text:span text:style-name="Ultimus_5f_Testo"><text:span text:style-name="T347"> </text:span></text:span><text:span text:style-name="Ultimus_5f_Testo"><text:span text:style-name="T657">Doppi in Elenco Prezzi</text:span></text:span><text:span text:style-name="Ultimus_5f_Testo"><text:span text:style-name="T655"> </text:span></text:span><text:span text:style-name="T208">ci informa sull&apos;esistenza di eventuali </text:span><text:span text:style-name="T658">voci </text:span><text:span text:style-name="T659">diverse </text:span><text:span text:style-name="T658">individuate dallo stesso codice</text:span><text:span text:style-name="T208"> </text:span><text:span text:style-name="T658">e ci chiede se vogliamo procedere alla loro eliminazione, dandoci modo di tornare sui nostri passi per effettuare le opportune verifiche; </text:span><text:span text:style-name="T659">operazione, quest’ultima, facilitata da </text:span><text:span text:style-name="T660">Riordina Elenco Prezzi</text:span><text:span text:style-name="T208">.</text:span></text:p>
   <text:h text:style-name="P182" text:outline-level="3"><text:bookmark-start text:name="__RefHeading__14655_1613112675"/>Sommari <text:span text:style-name="T661">e Quadri di raffronto</text:span><text:bookmark-end text:name="__RefHeading__14655_1613112675"/></text:h>
   <text:p text:style-name="P302"><text:span text:style-name="T3">Nell&apos;</text:span><text:span text:style-name="Ultimus_5f_Testo"><text:span text:style-name="T113">Elenco Prezzi</text:span></text:span><text:span text:style-name="T3"> è possibile </text:span><text:span text:style-name="T662">calcolare le quantità totali e relativi import, per ognuna delle voci, con il comando </text:span><text:span text:style-name="Ultimus_5f_Testo"><text:span text:style-name="T663">VISTE&gt;</text:span></text:span><text:span text:style-name="Ultimus_5f_Testo"><text:span text:style-name="T664">Visualizza&gt;</text:span></text:span><text:span text:style-name="Ultimus_5f_Testo"><text:span text:style-name="T663">Sommari</text:span></text:span><text:span text:style-name="Ultimus_5f_Testo"><text:span text:style-name="T3">, </text:span></text:span><text:span text:style-name="T3">così </text:span><text:span text:style-name="T662">come annoverate in </text:span><text:span text:style-name="Ultimus_5f_Testo"><text:span text:style-name="T113">COMPUTO,</text:span></text:span><text:span text:style-name="T665"> </text:span><text:span text:style-name="Ultimus_5f_Testo"><text:span text:style-name="T666">VARIANTE</text:span></text:span><text:span text:style-name="T665"> </text:span><text:span text:style-name="T662">e </text:span><text:span text:style-name="T667">CONTABILITA.</text:span></text:p>
   <table:table table:name="Tabella56" table:style-name="Tabella56">
    <table:table-column table:style-name="Tabella56.A"/>
    <text:soft-page-break/>
    <table:table-row>
