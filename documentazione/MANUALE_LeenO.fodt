   <text:p text:style-name="P433"/>
   <table:table table:name="Tabella18" table:style-name="Tabella18">
    <table:table-column table:style-name="Tabella18.A"/>
    <table:table-column table:style-name="Tabella18.B"/>
    <text:soft-page-break/>
    <table:table-row table:style-name="Tabella18.1">
     <table:table-cell table:style-name="Tabella18.A1" office:value-type="string">
      <text:p text:style-name="P434">Tip</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Tabella18.B1" office:value-type="string">
      <text:p text:style-name="P433"><text:span text:style-name="T1106">Un&apos;interessante opzione è la &quot;conversione&quot; di un </text:span><text:span text:style-name="T1107">COMPUTO/VARIANTE</text:span><text:span text:style-name="T1106"> in </text:span><text:span text:style-name="T1107">CONTABILITA</text:span><text:span text:style-name="T1106"> e viceversa, utilizzando l&apos;esportazione e la successiva reimportazione attraverso il formato XPWE.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:h text:style-name="P435" text:outline-level="3"><text:bookmark-start text:name="__RefHeading__9332_758364849"/><text:span text:style-name="T1108">Adeguamento</text:span><text:bookmark-start text:name="aggiornamento di un vecchio file"/><text:span text:style-name="T3"> di un vecchio file</text:span><text:bookmark-end text:name="__RefHeading__9332_758364849"/><text:bookmark-end text:name="aggiornamento di un vecchio file"/></text:h>
   <text:p text:style-name="P436"><text:span text:style-name="T1109">L’adeguamento di vecchi lavori alla versione di </text:span><text:span text:style-name="T1110">LeenO</text:span><text:span text:style-name="T1109"> installata è proposta, con un messaggio, </text:span><text:span text:style-name="T286">quando, </text:span><text:span text:style-name="T1109">all’apertura di questi file, </text:span><text:span text:style-name="T286">alcuni </text:span><text:span text:style-name="T106">parametri</text:span><text:span text:style-name="T286"> di confronto tra caratteristiche del file da gestire e versione di LeenO installata non vengono verificati</text:span><text:span text:style-name="T1109">.</text:span></text:p>
   <table:table table:name="Tabella15" table:style-name="Tabella15">
    <table:table-column table:style-name="Tabella15.A"/>
    <table:table-row>
