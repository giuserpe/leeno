         <text:p text:style-name="Figure">Figura <text:sequence text:ref-name="refFigure16" text:name="Figure" text:formula="ooow:Figure+1" style:num-format="1">17</text:sequence><text:s/>- <text:span text:style-name="T584">Toolbar</text:span></text:p>
