 </dlg:styles>
 <dlg:bulletinboard>
  <dlg:text dlg:style-id="0" dlg:id="lblRiepilogo" dlg:tab-index="0" dlg:left="6" dlg:top="4" dlg:width="428" dlg:height="24" dlg:value="Riepilogo" dlg:multiline="true"/>
  <dlg:button dlg:style-id="0" dlg:id="btnTutte" dlg:tab-index="1" dlg:left="6" dlg:top="214" dlg:width="50" dlg:height="15" dlg:value="Tutte" dlg:help-text="Spunta tutte le voci"/>
  <dlg:button dlg:style-id="0" dlg:id="btnNessuna" dlg:tab-index="2" dlg:left="60" dlg:top="214" dlg:width="50" dlg:height="15" dlg:value="Nessuna" dlg:help-text="Toglie la spunta a tutte le voci"/>
  <dlg:button dlg:style-id="0" dlg:id="btnVerdi" dlg:tab-index="3" dlg:left="114" dlg:top="214" dlg:width="60" dlg:height="15" dlg:value="Solo VERDE" dlg:help-text="Spunta solo le voci VERDE"/>
  <dlg:button dlg:style-id="0" dlg:id="btnApplica" dlg:tab-index="4" dlg:left="326" dlg:top="214" dlg:width="50" dlg:height="15" dlg:default="true" dlg:value="Applica" dlg:button-type="ok"/>
  <dlg:button dlg:style-id="0" dlg:id="btnAnnulla" dlg:tab-index="5" dlg:left="384" dlg:top="214" dlg:width="50" dlg:height="15" dlg:value="Annulla" dlg:button-type="cancel"/>
 </dlg:bulletinboard>
